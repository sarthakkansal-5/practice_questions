#include <stdio.h>

struct vector {
    int a;
    int b;
};

void calcSum(struct vector v1, struct vector v2) {
    struct vector sum;
    sum.a = v1.a + v2.a;
    sum.b = v1.b + v2.b;
    printf("Result: Sum Vector = %di + %dj\n", sum.a, sum.b);
}

int main() {
    struct vector v1;
    struct vector v2;

    printf("Enter x component for vector 1: ");
    scanf("%d", &v1.a);
    printf("Enter y component for vector 1: ");
    scanf("%d", &v1.b);

    printf("Enter x component for vector 2: ");
    scanf("%d", &v2.a);
    printf("Enter y component for vector 2: ");
    scanf("%d", &v2.b);

    calcSum(v1, v2);

    return 0;
}